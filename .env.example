# Environment variables for Essence Pulse
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── AI Model Providers ─────────────────────────────────────────────────────────
# Leave all keys blank to use the offline StubAdapter (no API call needed).

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (planned adapter)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (planned adapter)
GOOGLE_API_KEY=your_google_api_key_here

# ── Model selection ────────────────────────────────────────────────────────────
# Which provider to use. Options: stub | openai | anthropic | gemini | local
# Default: stub (offline, no key required)
ESSENCE_PULSE_MODEL_PROVIDER=stub

# Model name within the chosen provider (e.g. gpt-4o, claude-opus-4-5)
ESSENCE_PULSE_MODEL_NAME=gpt-4o

# ── Audit log ──────────────────────────────────────────────────────────────────
# Optional path for persistent audit log (newline-delimited JSON).
# Leave blank for in-memory only.
ESSENCE_PULSE_AUDIT_LOG_PATH=

# ── Demo settings ──────────────────────────────────────────────────────────────
# Default demo scenario: scheduling_request | urgent_message | informational
ESSENCE_PULSE_DEMO_SCENARIO=scheduling_request

# Auto-approve actions in the demo (true/false). false = interactive prompts.
ESSENCE_PULSE_AUTO_APPROVE=false
